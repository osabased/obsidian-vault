#!/bin/sh
# raw/ holds what the user said and showed. A commit may add files there and append rows to the dated logs,
# but not delete, rename, rewrite or retype what is there.
changed=$(git diff --cached --name-only --diff-filter=DRTU -- raw/; git diff --cached --numstat --diff-filter=M -- raw/ | awk -F'\t' '$2 != "0" { print $3 }')
if [ -n "$changed" ] && [ "$VAULT_ALLOW_RAW_CHANGES" != 1 ]; then
  echo "raw/ is append-only, and this commit rewrites or removes:" >&2
  echo "$changed" | sed 's/^/  /' >&2
  echo "Unstage them, or commit with VAULT_ALLOW_RAW_CHANGES=1 if the user asked for it." >&2
  exit 1
fi
# Notes and sources don't change what the tests run, so only a change to the code, the plugin manifest, their tests or the
# oxlint rules waits on them.
if git diff --cached --name-only | grep -qE '^((tools|test|hooks|mcp|\.githooks|\.claude-plugin)/|\.oxlintrc\.json$|setup\.mjs$)'; then
  # oxlint is required for these commits, but it is not a dependency of the tools: nothing in tools/ imports it.
  if ! command -v oxlint >/dev/null 2>&1; then
    echo "oxlint is required to commit changes to the code: npm i -g oxlint@1.91.0" >&2
    exit 1
  fi
  oxlint --deny-warnings tools hooks mcp test setup.mjs || exit 1
  node --test --test-reporter=dot "test/*.test.mjs" || exit 1
fi
node tools/build.mjs || exit 1
gen="active.md index.md decisions.md queue.md"
# The generated files are built from the folder, which may hold notes the user keeps out of git. While a note, pick,
# queue entry or the config is not wholly in the commit, they would name what it lacks, so they stay out of it.
if git status --porcelain --untracked-files=all -- wiki raw/picks raw/queue vault.config.json | grep -qv '^[MADRC] '; then
  git reset -q -- $gen
  echo "pre-commit: active.md, index.md, decisions.md and queue.md stay out of this commit, since not every note they are built from is in it." >&2
else
  # A generated file the user keeps out of git is gitignored, and git add would refuse it.
  for f in $gen; do git check-ignore -q "$f" || git add "$f"; done
fi
exec node tools/lint.mjs --fail-on error

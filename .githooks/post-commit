#!/bin/sh
# The plugin's hooks run .live/tools/, a copy of tools/ as of HEAD, so a half-made change to tools/ never runs
# in a session. The copy is built beside the old one and swapped in, stamped with its tree as hooks/live.mjs
# stamps the copies it makes, so session start finds it current.
set -e
cd "$(git rev-parse --show-toplevel)"
rm -rf .live/tools.new .live/tools.old
mkdir -p .live/tools.new
git archive HEAD tools | tar -x -C .live/tools.new --strip-components=1
git rev-parse HEAD:tools > .live/tools.new/.tree
if [ -d .live/tools ]; then mv .live/tools .live/tools.old; fi
mv .live/tools.new .live/tools
rm -rf .live/tools.old
